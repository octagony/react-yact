{
  "name": "react-yact",
  "version": "0.1.0",
  "description": "Comments tree for React",
  "keywords": [
    "comments",
    "tree",
    "react",
    "component"
  ],
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && tsc --emitDeclarationOnly --declaration --outDir dist/types && tsc-alias -p tsconfig.json --outDir dist/types",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.3",
    "tsc-alias": "^1.9.10",
    "tslib": "^2.9.1",
    "typescript": "~5.9.0"
  }
}